{
  "name": "@primajin/caesar-salad",
  "version": "0.0.2",
  "description": "To Rome and back again",
  "license": "UNLICENSED",
  "repository": "github:Primajin/caesar-salad",
  "homepage": "https://github.com/Primajin/caesar-salad#readme",
  "bugs": "https://github.com/Primajin/caesar-salad/issues",
  "author": "Jannis Hell",
  "type": "module",
  "exports": "./index.js",
  "sideEffects": false,
  "engines": {
    "node": "^22.20 || ^24.12 || >=25"
  },
  "scripts": {
    "build": "node scripts/build.js --minify",
    "start": "node scripts/build.js --watch --sourcemap",
    "coverage": "c8 --reporter=lcov ava",
    "lint": "xo",
    "lint:fix": "xo --fix",
    "lint:watch": "npx nodemon -x npm run lint:fix --ext js,json",
    "test": "ava",
    "test:watch": "ava --watch",
    "docs": "jsdoc -c .jsdoc.json"
  },
  "files": [
    "index.js",
    "src"
  ],
  "keywords": [
    "caesar",
    "cypher",
    "vigenere",
    "cryptography",
    "salad"
  ],
  "devDependencies": {
    "ava": "^8.0.1",
    "c8": "^12.0.0",
    "docdash": "^2.0.2",
    "esbuild": "^0.28.1",
    "jsdoc": "^4.0.5",
    "xo": "^5.0.1"
  },
  "xo": {
    "ignores": [
      "docs",
      "package-lock.json"
    ]
  }
}
